  },
  {
   "fieldname": "einheit",
   "fieldtype": "Data",
   "label": "Einheit",
   "depends_on": "eval:doc.art=='Messwert'",
   "description": "Z. B. °C, °Brix, g"
  },
  {
   "fieldname": "min_wert",
   "fieldtype": "Data",
   "label": "Mindestens",
   "depends_on": "eval:doc.art=='Messwert'",
   "description": "Leer = keine Grenze. Dezimalzahl mit Komma oder Punkt."
  },
  {
   "fieldname": "max_wert",
   "fieldtype": "Data",
   "label": "Höchstens",
   "depends_on": "eval:doc.art=='Messwert'",
   "description": "Leer = keine Grenze. Dezimalzahl mit Komma oder Punkt."
