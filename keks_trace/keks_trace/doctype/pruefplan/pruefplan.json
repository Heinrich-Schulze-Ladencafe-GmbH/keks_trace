  },
  {
   "fieldname": "artikel",
   "fieldtype": "Table MultiSelect",
   "label": "Artikel",
   "options": "Pruefplan Artikel",
   "description": "Bei „Beim Herstellen“ / „Beim Wareneingang“: nur für diese Artikel. Leer = alle."
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break",
   "label": "Was wird geprüft"
  },
  {
   "fieldname": "art",
   "fieldtype": "Select",
